# DK Power database (use a dedicated database; never reuse another store's production DB)
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>"

# Admin Portal Credentials
# Set real values only in your local/deployment environment. Never commit them.
ADMIN_EMAIL="<your-admin-email>"
ADMIN_PASSWORD="<generate-a-unique-strong-password>"
JWT_SECRET="<generate-a-long-random-secret>"

# Public Store Information
NEXT_PUBLIC_STORE_NAME="DK Power"
NEXT_PUBLIC_STORE_TAGLINE="Wholesale Mobile Accessories & Power Solutions"
NEXT_PUBLIC_STORE_PHONE=""
NEXT_PUBLIC_STORE_WHATSAPP=""
NEXT_PUBLIC_STORE_EMAIL=""
NEXT_PUBLIC_STORE_ADDRESS=""
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_CURRENCY="PKR"
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD="0"
NEXT_PUBLIC_DEFAULT_DELIVERY_FEE="200"

# Tracking encryption: configure dedicated keys before rotating JWT_SECRET.
# Generate each key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# TRACKING_ENCRYPTION_KEYS={"v1":"<base64-encoded-32-byte-key>"}
# TRACKING_ENCRYPTION_ACTIVE_VERSION=v1
# Keep previous versions in TRACKING_ENCRYPTION_KEYS until old orders expire.
# TRACKING_LEGACY_SECRET=<original-JWT_SECRET>
